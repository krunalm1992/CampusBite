# Copy this file to .env and replace the placeholder secrets.
# Docker Compose reads this file. Do not commit .env.

POSTGRES_USER=campusbite
POSTGRES_PASSWORD=change-me
POSTGRES_DB=campusbite

# Used when you run the API on the host, against Postgres published on localhost.
# Docker Compose overrides this so the container uses the hostname "db".
DATABASE_URL=postgresql://campusbite:change-me@localhost:5433/campusbite

JWT_SECRET=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Leave blank to use the local order summary. Set a real key to call OpenAI.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

REMINDER_STALE_MINUTES=15
REMINDER_INTERVAL_SECONDS=60
AI_REQUESTS_PER_MINUTE=8
